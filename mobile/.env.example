# Copy to .env and fill in real local values. Never commit .env itself.
# Expo only exposes vars prefixed EXPO_PUBLIC_ to client code — never put secrets here,
# only values safe to ship inside the app bundle (they are visible to anyone who inspects the app).

# The backend has NO /api/v1 prefix. On a physical phone, set this to your computer's
# Wi-Fi/LAN IP (from `ipconfig` / `ifconfig`), not localhost — localhost resolves to the
# phone itself. A web preview or emulator can use http://localhost:8080.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Needs the "Maps JavaScript API" enabled for the key.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=replace-me

EXPO_PUBLIC_ENV=development
