# Copy to .env and fill in real local values. Never commit .env itself.
# Expo only exposes vars prefixed EXPO_PUBLIC_ to client code — never put secrets here,
# only values safe to ship inside the app bundle (they are visible to anyone who inspects the app).

EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=replace-me
EXPO_PUBLIC_ENV=development
