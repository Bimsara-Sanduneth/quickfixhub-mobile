# Copy to .env and fill in real local values. Never commit .env itself.

# Database
DB_URL=jdbc:postgresql://localhost:5432/quickfixhub
DB_USERNAME=quickfixhub
DB_PASSWORD=changeme

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=replace-with-a-long-random-value-min-32-chars
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30

# ─── Email / SMTP ────────────────────────────────────────────────────────────
# Option A (default): local Mailpit container from docker-compose. SMTP on 1025,
# every message viewable at http://localhost:8025, nothing is actually delivered.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=no-reply@quickfixhub.local
MAIL_FROM_NAME=QuickFixHub
PASSWORD_RESET_CODE_TTL_MINUTES=15

# Option B: real delivery through a Gmail account. Comment out the block above and
# use this instead.
#   1. The Google account MUST have 2-Step Verification turned on
#      (https://myaccount.google.com/signinoptions/twosv).
#   2. Create an App Password (https://myaccount.google.com/apppasswords) - pick
#      "Mail" / "Other". Google shows a 16-character value; use it WITHOUT spaces.
#      This is NOT your normal Gmail password and can be revoked any time.
#   3. SMTP_USERNAME and MAIL_FROM must both be that same Gmail address - Gmail
#      rejects a From it isn't authorised to send as.
#   4. Gmail free accounts cap at ~500 recipients/day.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your16charapppassword
# SMTP_AUTH=true
# SMTP_STARTTLS=true
# MAIL_FROM=you@gmail.com
# MAIL_FROM_NAME=QuickFixHub

# Firebase Cloud Messaging
FCM_SERVICE_ACCOUNT_PATH=./firebase-adminsdk.json

# Google Maps Platform
GOOGLE_MAPS_API_KEY=replace-me

# AWS S3 (media uploads)
AWS_S3_BUCKET=quickfixhub-media
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_REGION=us-east-1

# App
SPRING_PROFILES_ACTIVE=local
